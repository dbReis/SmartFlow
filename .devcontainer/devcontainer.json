{
  "name": "SmartFlow",
  // Two containers: "app" (this one, where VS Code runs) and "db" (PostgreSQL).
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/SmartFlow",
  // Stop the database too when VS Code closes the dev container.
  "shutdownAction": "stopCompose",
  "remoteUser": "dev",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "Tornado API" }
  },
  "postCreateCommand": "if [ -f pyproject.toml ]; then uv sync; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        // Suggest imports from installed libraries, not just from the project
        "python.analysis.autoImportCompletions": true,
        // Index deeper than top level so e.g. sqlalchemy.ext.asyncio is found
        "python.analysis.packageIndexDepths": [
          { "name": "sqlalchemy", "depth": 4 },
          { "name": "tornado", "depth": 2 },
          { "name": "pydantic_settings", "depth": 2 }
        ],
        // Ruff is both the linter and the formatter
        "ruff.lint.enable": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          // Show the suggestion list while typing and after ".", not only on Ctrl+Space
          "editor.quickSuggestions": { "other": "on", "comments": "off", "strings": "off" },
          "editor.suggestOnTriggerCharacters": true,
          "editor.codeActionsOnSave": {
            // Apply Ruff's auto-fixable lint fixes on save
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
